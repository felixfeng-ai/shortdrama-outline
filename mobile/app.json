{
  "expo": {
    "name": "成剧",
    "slug": "veyaframe",
    "version": "1.0.0",
    "description": "面向短剧与漫剧创作者的 AI 创作、分镜与审片 Agent。",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "veyaframe",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "work.chenju.veyaframe"
    },
    "android": {
      "package": "work.chenju.veyaframe",
      "adaptiveIcon": {
        "backgroundColor": "#FCFBF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFBF8"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "成剧需要访问相册，以便添加创作参考图。",
          "cameraPermission": "成剧需要使用相机，以便拍摄创作参考图。"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "成剧需要使用麦克风，以便把语音转成创作指令。",
          "speechRecognitionPermission": "成剧需要使用语音识别，以便转写你的创作指令。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
