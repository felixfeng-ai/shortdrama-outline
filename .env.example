# 复制本文件为 .env.local 后填入真实值：cp .env.example .env.local

# DeepSeek API Key（必填）。申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 可选：以下两项留空则用默认值
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# DEEPSEEK_MODEL="deepseek-chat"

# 阿里云百炼 / 通义万相（服务端托管，普通用户不需要填写）
ALIYUN_DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ALIYUN_IMAGE_MODEL="wanx2.1-t2i-turbo"
ALIYUN_IMAGE_EDIT_MODEL="qwen-image-2.0-pro"

# Web Push（服务端生成 VAPID 密钥，私钥不要暴露到浏览器）
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@chengju.work"

# 原生订阅商品与外部收据核验。未配置时交易只能保持待核验。
APP_BILLING_PRODUCT_IDS=""
BILLING_VERIFICATION_URL=""
BILLING_VERIFICATION_SECRET=""

# 登录验证码哈希密钥；生产必须设置强随机值
AUTH_SECRET=""
# 仅 localhost 联调时允许返回 devCode；生产域名不会生效
AUTH_ALLOW_DEV_CODE="0"

# 邮箱验证码（生产登录推荐）。Resend 需要先验证发件域名。
RESEND_API_KEY=""
AUTH_EMAIL_FROM="成剧 VeyaFrame <login@chenju.work>"

# 可选：公开文档仓库地址。留空时 Agent 只显示出处文本，不生成外链。
NEXT_PUBLIC_PROJECT_REPO_URL=""

# 验证码发送风控（按来源 IP 与全站预算）
AUTH_CODE_IP_10M_LIMIT="5"
AUTH_CODE_IP_DAILY_LIMIT="20"
AUTH_CODE_GLOBAL_DAILY_LIMIT="200"

# 生产调用风控。每组都有 IP 十分钟、账号十分钟与全站 24 小时预算。
API_MODEL_IP_10M_LIMIT="60"
API_MODEL_IDENTITY_10M_LIMIT="30"
API_MODEL_GLOBAL_DAILY_LIMIT="2000"
API_ASSISTANT_IP_10M_LIMIT="40"
API_ASSISTANT_IDENTITY_10M_LIMIT="20"
API_ASSISTANT_GLOBAL_DAILY_LIMIT="1500"
API_IMAGE_IP_10M_LIMIT="20"
API_IMAGE_IDENTITY_10M_LIMIT="10"
API_IMAGE_GLOBAL_DAILY_LIMIT="500"
API_EXPORT_IP_10M_LIMIT="30"
API_EXPORT_IDENTITY_10M_LIMIT="20"
API_EXPORT_GLOBAL_DAILY_LIMIT="1000"
API_IMPORT_IP_10M_LIMIT="10"
API_IMPORT_IDENTITY_10M_LIMIT="5"
API_IMPORT_GLOBAL_DAILY_LIMIT="200"
API_MATERIAL_IP_10M_LIMIT="20"
API_MATERIAL_IDENTITY_10M_LIMIT="12"
API_MATERIAL_GLOBAL_DAILY_LIMIT="500"
